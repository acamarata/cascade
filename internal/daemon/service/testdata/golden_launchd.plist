<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.acamarata.cascade</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/cascade</string>
		<string>daemon</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/example/.cascade/logs/daemon.log</string>
	<key>StandardOutPath</key>
	<string>/Users/example/.cascade/logs/daemon.log</string>
</dict>
</plist>
