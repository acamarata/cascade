<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.cascade.refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>@BIN@/cascade-dash > /dev/null 2>&amp;1</string>
    </array>
    <key>StartInterval</key>
    <integer>15</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/cascade-dash-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/cascade-dash-refresh.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@BIN@:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@HOME@</string>
    </dict>
</dict>
</plist>
