#!/usr/bin/env bash
# claw-fleet-sync — After editing the repo, re-copy bin scripts + widget to
# their deployed locations. Needed because the scripts CANNOT be symlinks
# (launchd refuses symlinks across volume boundaries).

set -euo pipefail

# Find the repo. In order of preference:
#   1. CLAW_FLEET_REPO env var
#   2. ~/.config/claw-fleet/repo-path (written at install time)
#   3. Current working directory if it looks like the repo
#   4. Script's own parent dir (if run from inside the repo)
find_repo() {
  if [ -n "${CLAW_FLEET_REPO:-}" ] && [ -f "$CLAW_FLEET_REPO/src/bin/claw-fleet" ]; then
    echo "$CLAW_FLEET_REPO"; return 0
  fi
  if [ -f "$HOME/.config/claw-fleet/repo-path" ]; then
    local p; p=$(cat "$HOME/.config/claw-fleet/repo-path")
    if [ -f "$p/src/bin/claw-fleet" ]; then echo "$p"; return 0; fi
  fi
  if [ -f "./src/bin/claw-fleet" ]; then echo "$(pwd)"; return 0; fi
  local self_repo; self_repo="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd || true)"
  if [ -n "$self_repo" ] && [ -f "$self_repo/src/bin/claw-fleet" ]; then echo "$self_repo"; return 0; fi
  return 1
}

REPO=$(find_repo) || { echo "ERR: cannot locate claw-fleet repo. Set CLAW_FLEET_REPO=/path/to/repo or cd into it." >&2; exit 1; }
echo "repo: $REPO"

BIN="$HOME/bin"
UBW="$HOME/Library/Application Support/Übersicht/widgets/claw-fleet.widget"
SBP="$HOME/Library/Application Support/SwiftBar/Plugins/claw-fleet.5s.sh"

mkdir -p "$BIN"
cp "$REPO/src/bin/claw-fleet"          "$BIN/claw-fleet"
cp "$REPO/src/bin/claw-fleet-refresh"  "$BIN/claw-fleet-refresh"
cp "$REPO/src/bin/claw-fleet-watchdog" "$BIN/claw-fleet-watchdog"
cp "$REPO/src/bin/claw-fleet-sanity"   "$BIN/claw-fleet-sanity"
cp "$REPO/src/bin/claw-fleet-sync"     "$BIN/claw-fleet-sync"
cp "$REPO/src/bin/claw-fleet-codex"    "$BIN/claw-fleet-codex"
cp "$REPO/src/bin/claw-fleet-gemini"   "$BIN/claw-fleet-gemini"
cp "$REPO/src/bin/claw-fleet-opencode" "$BIN/claw-fleet-opencode"
chmod +x "$BIN"/claw-fleet*
echo "✓ bin scripts synced"

# Widget: only copy if the deployed path is a real dir (not a symlink — symlinks = dev mode).
if [ -e "$UBW" ] && [ ! -L "$UBW" ]; then
  rm -rf "$UBW"
  cp -R "$REPO/src/widgets/ubersicht/claw-fleet.widget" "$UBW"
  echo "✓ widget synced"
fi

# SwiftBar plugin — same dev-vs-copy detection.
if [ -e "$SBP" ] && [ ! -L "$SBP" ]; then
  cp "$REPO/src/widgets/swiftbar/claw-fleet.5s.sh" "$SBP"
  chmod +x "$SBP"
  echo "✓ swiftbar plugin synced"
fi

# Reload LaunchAgents so they pick up the new binaries.
for label in io.clawfleet.refresh io.clawfleet.watchdog; do
  plist="$HOME/Library/LaunchAgents/${label}.plist"
  if [ -f "$plist" ]; then
    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist"
    echo "✓ reloaded $label"
  fi
done
