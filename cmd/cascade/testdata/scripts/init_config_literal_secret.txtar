# init_config_literal_secret.txtar
#
# Executable form: cmd/cascade/init_config_test.go's
# TestInitConfigLiteralSecret. See init_config_valid.txtar's header for
# why this repo carries no testscript runner.

# A setup file is a file people commit. A key written into one is refused
# before any step executes, so nothing is configured and no credential is
# recorded.
! exec cascade init --config cascade-init.toml
stderr 'credential material'
stderr 'vault set'

# The refusal must not quote what it found: an error carrying a secret
# copies it into a terminal, a CI log and a support ticket.
! stderr 'sk-ant-api03'

# Refused before step 1, so the cascade home does not exist.
! exists $HOME/.cascade

-- cascade-init.toml --
schema = "cascade.init/v1"

[[providers]]
name = "anthropic"
auth = "key-env"
key_env = "sk-ant-api03-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
