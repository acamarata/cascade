[package]
name        = "{{plugin_name}}"
version     = "0.1.0"
edition     = "2021"
description = "{{description}}"
authors     = ["{{author}}"]
license     = "MIT"

[lib]
crate-type = ["cdylib"]

[dependencies]
cascade-pdk = { path = "../../crates/cascade-pdk" }
serde       = { version = "1", default-features = false, features = ["derive", "alloc"] }
serde_json  = { version = "1", default-features = false, features = ["alloc"] }

[dev-dependencies]
cascade-pdk = { path = "../../crates/cascade-pdk", features = ["test-harness"] }
