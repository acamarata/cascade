# Maintainer: Aric Camarata <aric.camarata@gmail.com>
pkgname=cascade-bin
pkgver=1.16.0
pkgrel=1
pkgdesc="Unified AI instruction cascade manager — daemon, CLI, and context resolver"
arch=('x86_64' 'aarch64')
url="https://github.com/acamarata/cascade"
license=('MIT')
depends=('glibc' 'gtk3' 'webkit2gtk')
provides=('cascade')
conflicts=('cascade' 'cascade-git')

source_x86_64=("cascade-${pkgver}-x86_64.tar.gz::https://github.com/acamarata/cascade/releases/download/v${pkgver}/cascade_${pkgver}_linux_x86_64.tar.gz")
source_aarch64=("cascade-${pkgver}-aarch64.tar.gz::https://github.com/acamarata/cascade/releases/download/v${pkgver}/cascade_${pkgver}_linux_aarch64.tar.gz")

sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "${srcdir}"

    # Binaries
    install -Dm755 cascade    "${pkgdir}/usr/bin/cascade"
    install -Dm755 cascaded   "${pkgdir}/usr/bin/cascaded"

    # Desktop integration
    install -Dm644 cascade.desktop "${pkgdir}/usr/share/applications/cascade.desktop"

    # Systemd user unit
    install -Dm644 cascade@.service "${pkgdir}/usr/lib/systemd/user/cascade@.service"

    # License
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
