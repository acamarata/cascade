node_modules/
.DS_Store
*.log

# Secrets
*.pem
*.key
*.secret
.env*
*.local
.claude/
.vscode/*
.idea/
.codex/
.cursor/
.aider/
.aider.chat.history.md
.continue/
.windsurf/
.gemini/
.codeium/
target/
# Ignore all .cascade/ runtime content except the repo's own PRC file
.cascade/*
.cascade/temp/
# Track the repo's own PRC instruction file and its gitignore
!.cascade/CASCADE.md
!.cascade/.gitignore

# Stray compiler intermediates (never commit)
*.rcgu.o
rust_out*
rustc*/

# Native macOS widget build output (Xcode DerivedData / archive staging)
src/widget/macos/build/

# Linux widget build artifacts (packed bundles, not source)
*.zip
*.plasmoid
/~/

# Compiled Vite config artifacts — vite.config.ts is the single source of truth.
# A committed vite.config.js SHADOWS the .ts (Vite resolves .js first), which
# silently made edits to the .ts source ineffective (T-P7-E17-02).
apps/*/vite.config.js
apps/*/vite.config.d.ts
