# AI workspace (never tracked)
.claude/
.opencode/

# OS
.DS_Store

# build output (Go)
/bin/
/dist/
*.log
/cascade
*.exe
*.test

# ephemeral minisign e2e keypair (P1-E01-W1-S01-T6 local snapshot verification
# only — real escrowed keys are env-refs, never tracked; this dir must not
# exist outside a throwaway local check)
/.minisign-e2e/

# test and coverage artifacts (Go)
*.out
coverage.txt
coverage.html

# Coverage profiles written by the gate checks and contract check lines.
.cover/

# internal/migration's drift-detection fixture is a checked-in test input
# named .claude/CLAUDE.md, not an AI workspace file; the blanket .claude/
# rule above would otherwise silently drop it from every checkout
# (TestDriftReportRed then reads a missing file as empty content).
!/internal/migration/testdata/fixture_project/.claude/
!/internal/migration/testdata/fixture_project/.claude/CLAUDE.md
