<?xml version="1.0" encoding="utf-8"?>
<!--
  App.xaml — Cascade Widget (Windows 11 WinUI 3)
  Purpose:  Application entry point; loads theme resources and registers the
            widget provider with the Windows Widget Board.
  SPORT:    cascade/apps/cascade-widget-windows
-->
<Application
    x:Class="CascadeWidget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/CascadeTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
