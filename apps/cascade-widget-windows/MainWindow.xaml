<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml — Cascade Widget (Windows 11 WinUI 3)
  Purpose:  Widget board entry surface. Shows tier status rows (T0-T3),
            a Gemini proxy heartbeat indicator, and quota bars per account.
  Layout:   580×420 compact panel designed for the Windows Widget Board
            large-size slot (373×466 device pixels at 100% scaling).
  Constraints:
    - All data is bound to MainWindowViewModel (MVVM, no code-behind logic).
    - Refresh triggered by DaemonIpcClient.StatusChanged event.
  SPORT: cascade/apps/cascade-widget-windows
-->
<Window
    x:Class="CascadeWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CascadeWidget.Models"
    mc:Ignorable="d"
    Title="Cascade">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header: title + daemon status -->
            <RowDefinition Height="*" />     <!-- Tier rows -->
            <RowDefinition Height="Auto" />  <!-- Footer: last-updated timestamp -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Ellipse Width="10" Height="10"
                     Fill="{x:Bind ViewModel.DaemonOnline, Mode=OneWay,
                            Converter={StaticResource BoolToBrushConverter}}" />
            <TextBlock Text="Cascade Fleet" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ProxyAddress, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" FontSize="11" />
        </StackPanel>

        <!-- ── Tier rows ──────────────────────────────────────────────────── -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Tiers, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TierStatus">
                    <Grid Margin="0,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />   <!-- Tier label -->
                            <ColumnDefinition Width="*" />    <!-- Quota bar  -->
                            <ColumnDefinition Width="60" />   <!-- % text     -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />

                        <ProgressBar Grid.Column="1"
                                     Value="{x:Bind QuotaPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Foreground="{x:Bind QuotaPercent, Mode=OneWay,
                                                  Converter={StaticResource QuotaColorConverter}}" />

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind QuotaPercent, Mode=OneWay,
                                          Converter={StaticResource PercentTextConverter}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── Footer ─────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.LastUpdated, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   FontSize="10"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
