<?xml version="1.0" encoding="utf-8"?>
<!--
  packages.config — Cascade Widget Provider
  Purpose:  NuGet package list for MSBuild restore. Used by the CI 'widget-windows'
            job which calls `nuget restore CascadeWidget.sln` before MSBuild.
  SPORT: cascade/apps/cascade-widget-windows
-->
<packages>
  <package id="Microsoft.WindowsAppSDK"
           version="1.5.240627000"
           targetFramework="native" />
  <package id="Microsoft.Windows.CppWinRT"
           version="2.0.240405.15"
           targetFramework="native" />
  <package id="Microsoft.Windows.ImplementationLibrary"
           version="1.0.240803.1"
           targetFramework="native" />
</packages>
