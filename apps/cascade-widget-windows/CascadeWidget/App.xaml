<?xml version="1.0" encoding="utf-8"?>
<!--
  App.xaml — Cascade Widget Provider
  Purpose:  Application entry point definition for the WinUI 3 packaged app.
            Loads theme resources and wires the App class defined in App.xaml.cpp.
  Constraints:
    - x:Class must match the namespace and class name in App.xaml.cpp.
    - Only XamlControlsResources is required; keep the app shell minimal since
      the Widget Board host drives rendering, not this XAML window.
  SPORT: cascade/apps/cascade-widget-windows
-->
<Application
    x:Class="CascadeWidget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 default control styles -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
