{
  "$schema": "https://schema.tauri.app/config/2/capability.json",
  "identifier": "default",
  "description": "Default capability set for the main Cascade window. Minimal by design — only the commands and APIs the UI actually calls are listed here. Add with care; each entry is an attack surface.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:webview:allow-set-webview-background-color",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",

    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-mkdir",

    "opener:allow-open-url",
    "shell:allow-open"
  ]
}
