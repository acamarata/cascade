{
  "_comment": "The one adversarial DSN table (P1-SEC-29 probes plus the P1-SEC-45 forms). Tokens: {c} canary, {c1} canary minus its first byte, {pct} canary fully %-encoded, {part} canary with c as %63, {bsl}/{bslDec} key=value backslash-escaped space and its decoding, {quo}/{quoDec} escaped quote inside quotes and its decoding, {pw1}/{pw2} two differing passwords, {hostPw}/{dbPw} passwords that equal a host or dbname. forbid lists the values no output may hold (the DSN itself is always added). render is Redact's exact output. The is-port rows use five-digit ports so a forbidden leading segment cannot match by chance. fragment marks a row whose password only contains the canary.",
  "forms": [
    {"name": "url-userinfo", "dsn": "postgres://u:{c}@localhost:5432/db?sslmode=disable", "forbid": ["{c}", "u:{c}"], "render": "postgres://u:xxxxx@localhost:5432/db"},
    {"name": "url-malformed", "dsn": "postgres://u:{c}@[::1", "forbid": ["{c}", "u:{c}"], "render": "<redacted-dsn>"},
    {"name": "url-query-password", "dsn": "postgres://u@localhost/db?sslmode=disable&password={c}", "forbid": ["{c}"], "render": "postgres://u@localhost/db"},
    {"name": "url-query-password-first", "dsn": "postgres://u@localhost/db?password={c}&sslmode=disable", "forbid": ["{c}"], "render": "postgres://u@localhost/db"},
    {"name": "url-query-password-upper", "dsn": "postgres://u@localhost/db?sslmode=disable&PASSWORD={c}", "forbid": ["{c}"], "render": "postgres://u@localhost/db"},
    {"name": "url-query-password-mixed-middle", "dsn": "postgres://u@localhost/db?sslmode=disable&Password={c}&application_name=x", "forbid": ["{c}"], "render": "postgres://u@localhost/db"},
    {"name": "url-query-password-bad-port", "dsn": "postgres://u@localhost:99x/db?password={c}", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "url-percent-encoded", "dsn": "postgres://u:{pct}@localhost/db?sslmode=disable", "forbid": ["{c}", "{pct}"], "render": "postgres://u:xxxxx@localhost/db"},
    {"name": "url-bad-escape", "dsn": "postgres://u:{c}%zz@localhost/db", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "url-colon-in-password", "dsn": "postgres://u:{c}:{c}@[::1", "forbid": ["{c}"], "fragment": true, "render": "<redacted-dsn>"},
    {"name": "url-postgresql-scheme", "dsn": "postgresql://u:{c}@localhost/db?sslmode=disable", "forbid": ["{c}", "u:{c}"], "render": "postgresql://u:xxxxx@localhost/db"},
    {"name": "url-fragment", "dsn": "postgres://u:{c}@localhost/db?sslmode=disable#{pw1}", "forbid": ["{c}", "{pw1}"], "render": "postgres://u:xxxxx@localhost/db"},
    {"name": "url-scheme-guard", "dsn": "postgresx://u:{c}@localhost/db", "forbid": ["{c}", "u:{c}"], "render": "<redacted-dsn>"},
    {"name": "kv-plain", "dsn": "host=localhost user=u password={c} dbname=db sslmode=disable", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "kv-password-first", "dsn": "password={c} host=localhost user=u dbname=db sslmode=disable", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "kv-password-last", "dsn": "host=localhost user=u dbname=db sslmode=disable password={c}", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "kv-quoted-plain", "dsn": "host=localhost user=u password='{c}' sslmode=disable", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "kv-spaced-equals", "dsn": "host=localhost port=bad user=u password = {c} dbname=db", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "kv-spaced-equals-valid", "dsn": "host=localhost user=u password = {c} dbname=db sslmode=disable", "forbid": ["{c}"], "render": "<redacted-dsn>"},
    {"name": "kv-quoted-spaces", "dsn": "host=localhost user=u password='{c} x y' dbname=db sslmode=disable", "forbid": ["{c}", "{c} x y"], "fragment": true, "render": "<redacted-dsn>"},
    {"name": "kv-quoted-bad-port", "dsn": "host=localhost port=bad password='{c} x y'", "forbid": ["{c}"], "fragment": true, "render": "<redacted-dsn>"},
    {"name": "password-is-host", "dsn": "postgres://u:{hostPw}@{hostPw}.invalid/db?sslmode=disable", "forbid": ["{hostPw}"], "render": "<redacted-dsn>"},
    {"name": "password-in-dbname", "dsn": "host=localhost user=u password={dbPw} dbname={dbPw}x sslmode=disable", "forbid": ["{dbPw}"], "render": "<redacted-dsn>"},
    {"name": "url-userinfo-raw-escapes", "dsn": "postgres://u:{part}@localhost/db?sslmode=disable", "forbid": ["{c}", "{part}", "u:{part}"], "render": "postgres://u:xxxxx@localhost/db"},
    {"name": "url-userinfo-and-query-differ", "dsn": "postgres://u:{pw1}@localhost/db?sslmode=disable&password={pw2}", "forbid": ["{pw1}", "{pw2}", "u:{pw1}"], "render": "postgres://u:xxxxx@localhost/db"},
    {"name": "url-query-raw-escapes", "dsn": "postgres://u@localhost/db?sslmode=disable&password={part}", "forbid": ["{c}", "{part}"], "render": "postgres://u@localhost/db"},
    {"name": "url-query-two-passwords", "dsn": "postgres://u@localhost/db?password={pw1}&password={pw2}&sslmode=disable", "forbid": ["{pw1}", "{pw2}"], "render": "postgres://u@localhost/db"},
    {"name": "url-sslpassword", "dsn": "postgres://u@localhost/db?sslmode=disable&sslpassword={part}", "forbid": ["{c}", "{part}"], "render": "postgres://u@localhost/db"},
    {"name": "kv-backslash-space", "dsn": "host=localhost user=u password={bsl} dbname=db sslmode=disable", "forbid": ["{bsl}", "{bslDec}"], "render": "<redacted-dsn>"},
    {"name": "kv-quoted-escaped-quote", "dsn": "host=localhost user=u password='{quo}' dbname=db sslmode=disable", "forbid": ["{quo}", "'{quo}'", "{quoDec}"], "render": "<redacted-dsn>"},
    {"name": "kv-sslpassword", "dsn": "host=localhost user=u sslpassword='{bsl}' password={pw1} sslmode=disable", "forbid": ["{bsl}", "{bslDec}", "{pw1}"], "render": "<redacted-dsn>"},
    {"name": "kv-password-query-mark", "dsn": "host=localhost user=u password={c}?x sslmode=disable", "forbid": ["{c}", "{c}?x"], "fragment": true, "render": "<redacted-dsn>"},
    {"name": "url-query-escaped-key", "dsn": "postgres://u@localhost/db?sslmode=disable&password={pw1}&%70assword={pw2}", "forbid": ["{pw1}", "{pw2}"], "render": "postgres://u@localhost/db"},
    {"name": "url-query-plus-and-percent", "dsn": "postgres://u@localhost/db?sslmode=disable&password={pw1}&password={c}+x&password=%73{c1}+*", "forbid": ["{pw1}", "{c} x", "{c}+*"], "render": "postgres://u@localhost/db"},
    {"name": "url-slash-password-is-port", "dsn": "postgres://u:42421/{c}@localhost/db?sslmode=disable", "forbid": ["42421/{c}", "{c}", "42421"], "render": "<redacted-dsn>"},
    {"name": "url-slash-password-is-port-loopback", "dsn": "postgres://127.0.0.1:42425/{c}@localhost/db?sslmode=disable", "forbid": ["42425/{c}", "{c}", "42425"], "render": "<redacted-dsn>"},
    {"name": "url-query-mark-password-is-port", "dsn": "postgres://u:42422?{c}@localhost/db?sslmode=disable", "forbid": ["42422?{c}", "{c}", "42422"], "render": "<redacted-dsn>"},
    {"name": "url-hash-password-is-port", "dsn": "postgres://u:42423#{c}@h/db?sslmode=disable", "forbid": ["42423#{c}", "{c}", "42423"], "render": "<redacted-dsn>"},
    {"name": "url-single-slash", "dsn": "postgres:/u:{c}@localhost/db", "forbid": ["{c}", "u:{c}"], "render": "<redacted-dsn>"},
    {"name": "url-single-slash-query-mark", "dsn": "postgres:/u:42424?{c}@localhost/db", "forbid": ["{c}", "42424", "u:42424"], "render": "<redacted-dsn>"},
    {"name": "kv-surrounding-space", "dsn": "  host=localhost user=u sslmode=disable  ", "forbid": ["host=localhost user=u sslmode=disable"], "render": "<redacted-dsn>"},
    {"name": "empty-password", "dsn": "postgres://u:@localhost/db?sslmode=disable", "forbid": [], "render": "postgres://u:xxxxx@localhost/db"},
    {"name": "garbage", "dsn": "not a dsn {c}", "forbid": ["{c}"], "render": "<redacted-dsn>"}
  ]
}
